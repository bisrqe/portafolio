{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/:lang(es|fr)/:section(professional-projects|leadership)/:slug",
      "destination": "/app-shell.html"
    },
    {
      "source": "/:section(professional-projects|leadership)/:slug",
      "destination": "/app-shell.html"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
