# Copy this file to .env.local and fill in your values.
# All VITE_* variables are embedded in the public JavaScript bundle — never put secrets here.

# Cloudinary (image uploads from the admin dashboard; use an *unsigned* upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: lets this Google account open /admin before the `admin` claim is set.
# Writes still require the claim (see README → Admin access).
VITE_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Server-only variables (no VITE_ prefix: never sent to the browser).
# Used by /api/translate to translate the English content into Spanish and French.
# Set ONE provider; without any, the free MyMemory service is used (lower quality, daily limit).
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Optional: the endpoint otherwise reads VITE_FIREBASE_PROJECT_ID / VITE_ADMIN_EMAIL
FIREBASE_PROJECT_ID=
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Static prerendering (SEO) — see README → "Prerendering and SEO"
# Absolute site URL for canonical, og:url and the sitemap. On Vercel it defaults to the
# production domain (VERCEL_PROJECT_PRODUCTION_URL); set it if you use a custom domain.
SITE_URL=
# Vercel → Settings → Git → Deploy Hooks. Lets the dashboard rebuild the static pages after edits.
VERCEL_DEPLOY_HOOK_URL=
